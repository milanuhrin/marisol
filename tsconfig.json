{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "target": "es2019",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolvePackageJsonExports": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "paths": {
      "*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "custom.d.ts",
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx", "nodemon.js", "Node.js", "login.js",
  ],
  "exclude": [
    "node_modules"
  ]
}
